include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/SnesRecompSourceContract.cmake")

option(SNESRECOMP_PLATFORM_APU_EVENT_BATCH "Combine APU delay cycles between device events" OFF)

# Portable host optimizations; the original SPC instructions remain unchanged.
function(snesrecomp_platform_overlay_apu_events sources_var snesrecomp_root)
    set(_result)
    set(_found 0)
    set(_runtime_found 0)
    set(_directory "${CMAKE_BINARY_DIR}/generated/apu-events")
    file(MAKE_DIRECTORY "${_directory}")
    file(READ "${snesrecomp_root}/runner/src/apu_frame_clock.h" _clock)
    string(REPLACE "\r\n" "\n" _clock "${_clock}")
    string(SHA256 _clock_sha "${_clock}")
    if(NOT _clock_sha STREQUAL "7f0a999a97690632299d6c89fbd4e2d141bfc328f42a37a5e94243702754157e")
        message(FATAL_ERROR "Reviewed extended APU clock header changed: ${_clock_sha}")
    endif()
    set(_clock_expression [=[within * RTL_APU_CYCLES_PER_FRAME /
                               RTL_MASTER_CYCLES_PER_FRAME]=])
    string(FIND "${_clock}" "${_clock_expression}" _clock_at)
    if(_clock_at EQUAL -1)
        message(FATAL_ERROR "Reviewed extended APU clock expression changed")
    endif()
    string(REPLACE "${_clock_expression}" "snesrecomp_apu_frame_offset(within)" _clock "${_clock}")
    file(WRITE "${_directory}/apu_frame_clock.h" "#include \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include/snesrecomp_platform/apu_clock.h\"\n${_clock}")
    foreach(_input IN LISTS ${sources_var})
        get_filename_component(_name "${_input}" NAME)
        if(_name STREQUAL "common_rtl.c")
            file(READ "${_input}" _source)
            string(FIND "${_source}" "#include \"apu_frame_clock.h\"" _include_at)
            if(_include_at EQUAL -1)
                message(FATAL_ERROR "Missing extended APU clock include in runtime")
            endif()
            set(_anchor "#include \"apu_frame_clock.h\"")
            string(REPLACE "${_anchor}" "" _without "${_source}")
            string(LENGTH "${_source}" _before)
            string(LENGTH "${_without}" _after)
            string(LENGTH "${_anchor}" _length)
            math(EXPR _delta "${_before}-${_after}")
            if(NOT _delta EQUAL _length)
                message(FATAL_ERROR "Extended APU clock include must occur exactly once")
            endif()
            string(REPLACE "#include \"apu_frame_clock.h\"" "#include \"${_directory}/apu_frame_clock.h\"" _source "${_source}")
            file(WRITE "${_directory}/common_rtl.c" "${_source}")
            snesrecomp_platform_copy_source_contract("${_input}" "${_directory}/common_rtl.c")
            list(APPEND _result "${_directory}/common_rtl.c")
            math(EXPR _runtime_found "${_runtime_found}+1")
        elseif(_name STREQUAL "apu.c" OR _name STREQUAL "spc.c")
            file(READ "${_input}" _source)
            string(REPLACE "\r\n" "\n" _source "${_source}")
            string(SHA256 _sha "${_source}")
            if(_name STREQUAL "apu.c")
                if(NOT _sha STREQUAL "0f2838934ae5830c68dcbe5a63948168325a2c88142b8abc38ae9379fa8b4402")
                    message(FATAL_ERROR "Reviewed APU source changed: ${_sha}")
                endif()
                if(NOT SNESRECOMP_PLATFORM_APU_EVENT_BATCH)
                    list(APPEND _result "${_input}")
                    math(EXPR _found "${_found}+1")
                    continue()
                endif()
                string(REPLACE "bool apu_runToGuestCycle(" "bool snesrecomp_apu_run_reference(" _source "${_source}")
                string(REPLACE "#include \"../audio_trace.h\"" "#include \"audio_trace.h\"" _source "${_source}")
                string(APPEND _source "\n#include \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/apu_event_run.inc\"\n")
            else()
                if(NOT _sha STREQUAL "f4bafd70c3b32b6c0b605f3d8c0b79b621091a19ca1648a7a56f68d116768cb9")
                    message(FATAL_ERROR "Reviewed SPC source changed: ${_sha}")
                endif()
                string(REPLACE "#include \"apu.h\"" "#include \"apu.h\"\n#include \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/spc_ram_access.h\"" _source "${_source}")
                string(REPLACE "return apu_cpuRead(spc->apu, adr);" "return snesrecomp_spc_read_ram(spc->apu, adr);" _source "${_source}")
                string(REPLACE "apu_cpuWrite(spc->apu, adr, val);" "snesrecomp_spc_write_ram(spc->apu, adr, val);" _source "${_source}")
            endif()
            set(_output "${_directory}/${_name}")
            file(WRITE "${_output}" "${_source}")
            snesrecomp_platform_copy_source_contract("${_input}" "${_output}")
            get_filename_component(_parent "${_input}" DIRECTORY)
            set_property(SOURCE "${_output}" APPEND PROPERTY INCLUDE_DIRECTORIES "${_parent}")
            list(APPEND _result "${_output}")
            math(EXPR _found "${_found}+1")
        else()
            list(APPEND _result "${_input}")
        endif()
    endforeach()
    if(NOT _found EQUAL 2 OR NOT _runtime_found EQUAL 1)
        message(FATAL_ERROR "APU optimization requires exactly one runtime, APU and SPC source")
    endif()
    set(${sources_var} "${_result}" PARENT_SCOPE)
endfunction()
